import re
import sqlite3
from pathlib import Path

BASE_DIR = Path(__file__).resolve().parents[2]
DB_PATH = BASE_DIR / "borsa.db"


def parse_number(value):
    if value is None:
        return None

    value = str(value).strip()
    value = value.replace(".", "")
    value = value.replace(",", ".")

    try:
        return float(value)
    except (ValueError, TypeError):
        return None


def read_text(path):
    return Path(path).read_text(
        encoding="utf-8",
        errors="replace"
    )


def find_value(text, label):
    pattern = rf"{re.escape(label)}\s+((?:-?[\d.,]+\s+){{1,4}})"
    match = re.search(pattern, text, re.IGNORECASE)

    if not match:
        return None

    values = re.findall(
        r"-?[\d.,]+",
        match.group(1)
    )

    if not values:
        return None

    # İlk değer küçük bir dipnot numarasıysa atla
    if len(values) >= 2:
        first = parse_number(values[0])

        if first is not None and abs(first) <= 100:
            return parse_number(values[1])

    return parse_number(values[0])


def find_exact_line_value(text, label):
    for line in text.splitlines():
        line = line.strip()

        if not line.startswith(label):
            continue

        remainder = line[len(label):]

        # "Uzun Vadeli Borçlanmalar"
        # ile "Uzun Vadeli Borçlanmaların Kısa Vadeli Kısımları"
        # birbirine karışmasın.
        if label == "Uzun Vadeli Borçlanmalar":
            if remainder.lstrip().startswith("ın"):
                continue

        values = re.findall(
            r"-?[\d.,]+",
            remainder
        )

        if not values:
            continue

        if len(values) >= 2:
            first = parse_number(values[0])

            if first is not None and abs(first) <= 100:
                return parse_number(values[1])

        return parse_number(values[0])

    return None

def detect_period(period_text):
    period_text = str(period_text).upper()

    if "2026_1C" in period_text:
        return "2026_1Q", "2026-03-31"

    if "2025_1C" in period_text:
        return "2025_1Q", "2025-03-31"

    if "2025_2C" in period_text:
        return "2025_2Q", "2025-06-30"

    if "2025_3C" in period_text:
        return "2025_3Q", "2025-09-30"

    if "2025_YILLIK" in period_text:
        return "2025_YILLIK", "2025-12-31"

    raise ValueError(
        f"Tanımsız dönem: {period_text}"
    )


def import_astor_file(txt_path):
    txt_path = Path(txt_path)

    if not txt_path.exists():
        print("DOSYA YOK:")
        print(txt_path)
        return False

    text = read_text(txt_path)

    period, period_end = detect_period(
        txt_path.stem
    )

    revenue = find_value(
        text,
        "Hasılat"
    )

    net_profit = find_value(
        text,
        "DÖNEM KARI (ZARARI)"
    )

    if net_profit is None:
        net_profit = find_value(
            text,
            "Net Dönem Karı veya Zararı"
        )

    if net_profit is None:
        net_profit = find_value(
            text,
            "Sürdürülen Faaliyetler Dönem Karı (Zararı)"
        )

    cash = find_value(
        text,
        "Nakit ve Nakit Benzerleri"
    )

    short_term_financial_debt = find_exact_line_value(text, "Kısa Vadeli Borçlanmalar")
    current_portion_long_term_debt = find_exact_line_value(text, "Uzun Vadeli Borçlanmaların Kısa Vadeli Kısımları")
    long_term_financial_debt = find_exact_line_value(text, "Uzun Vadeli Borçlanmalar 4")

    equity = find_value(
        text,
        "Ana Ortaklığa Ait Özkaynaklar"
    )

    operating_cash_flow = find_value(
        text,
        "Faaliyetlerden Elde Edilen Nakit Akışları"
    )

    total_assets = find_value(
        text,
        "TOPLAM VARLIKLAR"
    )

    conn = sqlite3.connect(DB_PATH)

    conn.execute(
        """
        INSERT OR REPLACE INTO financial_statements (
            symbol,
            period,
            period_end,
            report_type,
            currency,
            revenue,
            net_profit,
            cash,
            short_term_financial_debt,
            current_portion_long_term_debt,
            long_term_financial_debt,
            total_assets,
            equity,
            operating_cash_flow,
            source,
            source_date,
            updated_at
        )
        VALUES (
            ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, CURRENT_TIMESTAMP
        )
        """,
        (
            "ASTOR",
            period,
            period_end,
            "Konsolide",
            "TRY",
            revenue,
            net_profit,
            cash,
            short_term_financial_debt,
            current_portion_long_term_debt,
            long_term_financial_debt,
            total_assets,
            equity,
            operating_cash_flow,
            "KAP",
            period_end
        )
    )

    conn.commit()
    conn.close()

    print("=" * 55)
    print(f"OK - {txt_path.name} aktarıldı")
    print("=" * 55)
    print("Dönem:", period)
    print("Dönem sonu:", period_end)
    print("Hasılat:", revenue)
    print("Net kâr:", net_profit)
    print("Nakit:", cash)
    print("Kısa vadeli finansal borç:", short_term_financial_debt)
    print(
        "KV uzun vadeli borç:",
        current_portion_long_term_debt
    )
    print(
        "Uzun vadeli finansal borç:",
        long_term_financial_debt
    )
    print("Toplam varlık:", total_assets)
    print("Özkaynak:", equity)
    print(
        "Faaliyet nakit akışı:",
        operating_cash_flow
    )
    print("=" * 55)

    return True


if __name__ == "__main__":

    files = [
        BASE_DIR
        / "data"
        / "financial_reports"
        / "2025"
        / "1C"
        / "astor_2025_1C.txt",

        BASE_DIR
        / "data"
        / "financial_reports"
        / "2025"
        / "2C"
        / "astor_2025_2c.txt",

        BASE_DIR
        / "data"
        / "financial_reports"
        / "2025"
        / "3C"
        / "astor_2025_3c.txt",

        BASE_DIR
        / "data"
        / "financial_reports"
        / "2025"
        / "YILLIK"
        / "ASTOR_2025_YILLIK.txt",

        BASE_DIR
        / "data"
        / "financial_reports"
        / "2026"
        / "1C"
        / "ASTOR_2026_1C.txt",
    ]

    for file_path in files:
        import_astor_file(file_path)